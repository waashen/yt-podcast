# Optional: Gemini API key (only needed if llm.provider = "gemini")
GEMINI_API_KEY=

# Optional: MiniMax Audio T2A v2 credentials (only needed if tts.provider = "minimax")
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# Use https://api.minimaxi.chat/v1/t2a_v2 for China mainland accounts
MINIMAX_API_URL=https://api.minimax.io/v1/t2a_v2

# Optional: Volcengine Doubao TTS credentials (only needed if tts.provider = "volcengine")
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_CLUSTER=volcano_tts

# Optional: S3 / Cloudflare R2 / Backblaze B2 credentials (only needed if publishing.backend = "s3")
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=
