# Optional: Gemini API key (only needed if llm.provider = "gemini")
GEMINI_API_KEY=

# Optional: Volcengine Doubao TTS credentials (only needed if tts.provider = "volcengine")
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_CLUSTER=volcano_tts

# Optional: S3 / Cloudflare R2 / Backblaze B2 credentials (only needed if publishing.backend = "s3")
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=
